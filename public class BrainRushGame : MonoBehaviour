using UnityEngine;
using UnityEngine.UI;
using TMPro;
using System.Collections.Generic;

public class BrainRushGame : MonoBehaviour
{
    [Header("UI")]
    public TMP_Text questionText;
    public TMP_Text scoreText;
    public TMP_Text streakText;
    public TMP_Text timerText;
    public TMP_Text messageText;

    public Button[] answerButtons;

    [Header("Game Settings")]
    public float startingTime = 10f;
    public int pointsPerAnswer = 10;

    private int score;
    private int streak;
    private float timeLeft;

    private int correctAnswer;
    private string correctEmoji;

    private bool gameRunning;

    void Start()
    {
        StartGame();
    }

    void Update()
    {
        if (!gameRunning)
            return;

        timeLeft -= Time.deltaTime;

        timerText.text = Mathf.CeilToInt(timeLeft).ToString();

        if (timeLeft <= 0)
        {
            TimeUp();
        }
    }

    public void StartGame()
    {
        score = 0;
        streak = 0;
        timeLeft = startingTime;

        gameRunning = true;

        messageText.text = "";

        UpdateUI();

        NewQuestion();
    }

    void NewQuestion()
    {
        timeLeft = Mathf.Max(
            4f,
            startingTime - (score / 100f)
        );

        int type = Random.Range(0, 4);

        switch (type)
        {
            case 0:
                NumberPuzzle();
                break;

            case 1:
                MathPuzzle();
                break;

            case 2:
                PatternPuzzle();
                break;

            case 3:
                OddEmojiPuzzle();
                break;
        }

        EnableButtons();
    }

    // -----------------------------
    // NUMBER PUZZLE
    // -----------------------------

    void NumberPuzzle()
    {
        int start = Random.Range(1, 20);
        int difference = Random.Range(2, 9);

        int a = start;
        int b = a + difference;
        int c = b + difference;
        int d = c + difference;

        correctAnswer = d + difference;

        questionText.text =
            $"{a}  →  {b}  →  {c}  →  {d}  →  ?";

        CreateNumberAnswers(correctAnswer);
    }

    // -----------------------------
    // MATH PUZZLE
    // -----------------------------

    void MathPuzzle()
    {
        int a = Random.Range(5, 30);
        int b = Random.Range(2, 15);

        int operation = Random.Range(0, 3);

        string symbol;

        if (operation == 0)
        {
            symbol = "+";
            correctAnswer = a + b;
        }
        else if (operation == 1)
        {
            symbol = "-";
            correctAnswer = a - b;
        }
        else
        {
            symbol = "×";
            correctAnswer = a * b;
        }

        questionText.text =
            $"{a} {symbol} {b} = ?";

        CreateNumberAnswers(correctAnswer);
    }

    // -----------------------------
    // PATTERN PUZZLE
    // -----------------------------

    void PatternPuzzle()
    {
        int start = Random.Range(2, 10);

        int a = start;
        int b = a * 2;
        int c = b * 2;
        int d = c * 2;

        correctAnswer = d * 2;

        questionText.text =
            $"{a}  →  {b}  →  {c}  →  {d}  →  ?";

        CreateNumberAnswers(correctAnswer);
    }

    // -----------------------------
    // EMOJI PUZZLE
    // -----------------------------

    void OddEmojiPuzzle()
    {
        string[] emojis =
        {
            "🍎",
            "🍌",
            "🍊",
            "🍇",
            "🍉",
            "🥝"
        };

        string normal = emojis[Random.Range(0, emojis.Length)];

        do
        {
            correctEmoji =
                emojis[Random.Range(0, emojis.Length)];

        } while (correctEmoji == normal);

        string[] board = new string[9];

        for (int i = 0; i < board.Length; i++)
        {
            board[i] = normal;
        }

        int oddPosition = Random.Range(0, board.Length);

        board[oddPosition] = correctEmoji;

        questionText.text =
            "FIND THE DIFFERENT ONE\n\n" +
            string.Join(" ", board);

        CreateEmojiAnswers(emojis, correctEmoji);
    }

    // -----------------------------
    // NUMBER ANSWERS
    // -----------------------------

    void CreateNumberAnswers(int correct)
    {
        List<int> answers = new List<int>();

        answers.Add(correct);

        while (answers.Count < 4)
        {
            int wrong =
                correct + Random.Range(-15, 16);

            if (!answers.Contains(wrong))
            {
                answers.Add(wrong);
            }
        }

        Shuffle(answers);

        for (int i = 0; i < answerButtons.Length; i++)
        {
            int value = answers[i];

            answerButtons[i].GetComponentInChildren<TMP_Text>()
                .text = value.ToString();

            answerButtons[i].onClick.RemoveAllListeners();

            answerButtons[i].onClick.AddListener(
                () => CheckNumberAnswer(value)
            );
        }
    }

    // -----------------------------
    // EMOJI ANSWERS
    // -----------------------------

    void CreateEmojiAnswers(
        string[] emojis,
        string correct
    )
    {
        List<string> answers =
            new List<string>();

        answers.Add(correct);

        Shuffle(emojis);

        foreach (string emoji in emojis)
        {
            if (!answers.Contains(emoji))
                answers.Add(emoji);

            if (answers.Count == 4)
                break;
        }

        Shuffle(answers);

        for (int i = 0; i < answerButtons.Length; i++)
        {
            string value = answers[i];

            answerButtons[i].GetComponentInChildren<TMP_Text>()
                .text = value;

            answerButtons[i].onClick.RemoveAllListeners();

            answerButtons[i].onClick.AddListener(
                () => CheckEmojiAnswer(value)
            );
        }
    }

    // -----------------------------
    // CHECK ANSWER
    // -----------------------------

    void CheckNumberAnswer(int answer)
    {
        if (!gameRunning)
            return;

        if (answer == correctAnswer)
        {
            CorrectAnswer();
        }
        else
        {
            WrongAnswer();
        }
    }

    void CheckEmojiAnswer(string answer)
    {
        if (!gameRunning)
            return;

        if (answer == correctEmoji)
        {
            CorrectAnswer();
        }
        else
        {
            WrongAnswer();
        }
    }

    // -----------------------------
    // CORRECT
    // -----------------------------

    void CorrectAnswer()
    {
        streak++;

        int bonus = streak >= 3 ? 5 : 0;

        score += pointsPerAnswer + bonus;

        messageText.text =
            streak >= 3
            ? "🔥 COMBO!"
            : "✓ CORRECT!";

        UpdateUI();

        NewQuestion();
    }

    // -----------------------------
    // WRONG
    // -----------------------------

    void WrongAnswer()
    {
        streak = 0;

        messageText.text =
            "❌ WRONG!";

        UpdateUI();

        NewQuestion();
    }

    // -----------------------------
    // TIME UP
    // -----------------------------

    void TimeUp()
    {
        gameRunning = false;

        streak = 0;

        messageText.text =
            "⏰ TIME UP!";

        DisableButtons();

        Invoke(nameof(StartGame), 2f);
    }

    // -----------------------------
    // UI
    // -----------------------------

    void UpdateUI()
    {
        scoreText.text =
            "Score: " + score;

        streakText.text =
            "🔥 " + streak;

        timerText.text =
            Mathf.CeilToInt(timeLeft).ToString();
    }

    void EnableButtons()
    {
        foreach (Button button in answerButtons)
        {
            button.interactable = true;
        }
    }

    void DisableButtons()
    {
        foreach (Button button in answerButtons)
        {
            button.interactable = false;
        }
    }

    // -----------------------------
    // SHUFFLE
    // -----------------------------

    void Shuffle<T>(IList<T> list)
    {
        for (int i = list.Count - 1; i > 0; i--)
        {
            int randomIndex =
                Random.Range(0, i + 1);

            T temp = list[i];

            list[i] = list[randomIndex];

            list[randomIndex] = temp;
        }
    }
}